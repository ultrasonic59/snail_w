#Rules
rule COMPILER_XCL
  command = C$:\iar\ewarm-9.60.2\common\bin\XclFileGenerator.exe $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$out
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = C$:\iar\ewarm-9.60.2\common\bin\SourceIndexer.exe $flags
